+VERSION_DIST:=$(if $(VERSION_DIST),$(VERSION_DIST),MeowWrt)
 VERSION_DIST_SANITIZED:=$(call sanitize,$(VERSION_DIST))
@@ -42,3 +45,3 @@
 VERSION_MANUFACTURER:=$(call qstrip,$(CONFIG_VERSION_MANUFACTURER))
