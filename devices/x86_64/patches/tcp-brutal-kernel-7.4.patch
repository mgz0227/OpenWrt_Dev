Subject: [PATCH] tcp-brutal: use tso_segs on kernel 7.4

Linux 7.4 removed the min_tso_segs congestion-control hook. The source
already provides a tso_segs implementation; define its feature switch while
building this 7.4-only package.

--- a/feeds/miaogongzi/package_kernel_tcp-brutal/Makefile
+++ b/feeds/miaogongzi/package_kernel_tcp-brutal/Makefile
@@ -27,7 +27,7 @@
 endef
 
 define Build/Compile
-	+$(KERNEL_MAKE) M=$(PKG_BUILD_DIR) modules
+	+$(KERNEL_MAKE) M=$(PKG_BUILD_DIR) CFLAGS_MODULE="-DBRUTAL_HAVE_TSO_SEGS" modules
 endef
 
 $(eval $(call KernelPackage,tcp-brutal))
