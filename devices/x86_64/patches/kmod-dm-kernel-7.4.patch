Subject: [PATCH] kernel: make kmod-dm depend on crypto-md5 on 7.4

The mixed source tree uses the 7.4 x86 kernel while the package metadata
only selects crypto-md5 for 7.3. Linux 7.4 dm modules require libmd5.ko.

--- a/package/kernel/linux/modules/block.mk
+++ b/package/kernel/linux/modules/block.mk
@@ -215,7 +215,7 @@ $(eval $(call KernelPackage,dax))
 define KernelPackage/dm
   SUBMENU:=$(BLOCK_MENU)
   TITLE:=Device Mapper
-  DEPENDS:=+kmod-crypto-manager +kmod-dax +KERNEL_KEYS:kmod-keys-encrypted +LINUX_7_3:kmod-crypto-md5
+  DEPENDS:=+kmod-crypto-manager +kmod-dax +KERNEL_KEYS:kmod-keys-encrypted +LINUX_7_3:kmod-crypto-md5 +LINUX_7_4:kmod-crypto-md5
   # All the "=n" are unnecessary, they're only there
   # to stop the config from asking the question.
   # MIRROR is M because I've needed it for pvmove.
